# HOH EPL operator site on the Moscow server (opens without a VPN): https://epl.109-172-113-187.sslip.io
# Imported by the clip server's /etc/hoh-clips/Caddyfile (one line: import /etc/hoh-epl/epl.caddy); this file lives
# in /etc/hoh-epl/. Read-only: pages from /opt/hoh-epl/repo/epl-site, data = the line job's site.json (written
# atomically every ~10 min). Certificate: Let's Encrypt TLS-ALPN on :443, like the clip host.
epl.109-172-113-187.sslip.io {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
	}

	# on-air state, logins and accounts (tools/epl_onair.py, hoh-epl-onair.service); it checks the session itself
	handle /api/onair/* {
		reverse_proxy 127.0.0.1:8096
	}

	# open without a login (owner 2026-10-23: the site only with one's own login): the login page and the OBS / vMix
	# overlay with what it draws (fonts, template, crests); the overlay reads only /api/onair/state
	@open path /login.html /login.js /overlay.html /overlay.js /plate.js /favicon.ico /assets/*
	handle @open {
		root * /opt/hoh-epl/repo/epl-site
		header Cache-Control "no-cache"
		file_server
	}

	handle /data/site.json {
		forward_auth 127.0.0.1:8096 {
			uri /api/onair/auth
		}
		root * /opt/hoh-epl/repo/local-data/epl/site
		rewrite * /site.json
		header Cache-Control "no-store"
		file_server
	}

	handle /robots.txt {
		respond `User-agent: *
Disallow: /
` 200
	}

	# everything else (the operator console) only after a login: no session -> 302 to /login.html
	handle {
		forward_auth 127.0.0.1:8096 {
			uri /api/onair/auth
		}
		root * /opt/hoh-epl/repo/epl-site
		header Cache-Control "no-cache"
		file_server
	}
}
