{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoh-nhl-daily-results",
  "account_id": "f7f0376bf1c44c4e3cef4a24adf1b66a",
  "main": "cloudflare-worker/src/worker-entry.js",
  "compatibility_date": "2026-05-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./cloudflare-worker/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": ["* * * * *", "*/5 * * * *", "*/2 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hoh-data-core",
      "database_id": "bc570e12-3416-453b-ad31-42a27612379a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TELEGRAM_MENU_CHAT_ID": "-1003167239288",
    "GITHUB_REPOSITORY": "RNGN-Home-of-Hockey/HOH_NHL_Daily_Results",
    "GITHUB_REF": "main",
    "GITHUB_DISPATCH_EVENT_POLL": "nhl_poll",
    "GITHUB_DISPATCH_EVENT_RESEND": "resend_last_day",
    "CLOUDFLARE_CRON_ENABLED": "1",
    "TELEGRAM_CENTER_DELIVERY_MODE": "polling",
    "TELEGRAM_CENTER_WEBHOOK_URL": "https://hoh-nhl-daily-results.rngn.workers.dev/telegram/center?v=20260921-1",
    "TELEGRAM_LIVE_NOTIFICATIONS_ENABLED": "1",
    "FAN_PREDICTIONS_DIGEST_ENABLED": "1",
    "TELEGRAM_CENTER_EVENT_STREAM_ENABLED": "0",
    "WINLINE_FEED_SYNC_ENABLED": "1",
    "BROADCAST_OPERATOR_OPEN": "1",
    "BROADCAST_RENDERER_URL": "https://hoh-broadcast-renderer.vercel.app",
    "TELEGRAM_PREGAME_MINUTES": "15",
    "BACKFILL_CANARY_ENABLED": "0",
    "FULL_BACKFILL_ENABLED": "0",
    "FULL_BACKFILL_NOT_BEFORE_UTC": "2026-09-11T00:05:00Z",
    "FULL_BACKFILL_JOB_ID": "history-20242025-v1",
    "FULL_BACKFILL_SEASON": "20242025",
    "FULL_BACKFILL_START_DATE": "2024-10-04",
    "FULL_BACKFILL_END_DATE": "2025-06-30",
    "FULL_BACKFILL_DAILY_GAME_LIMIT": "20",
    "FULL_BACKFILL_MAX_SCAN_DAYS": "14"
  }
}
